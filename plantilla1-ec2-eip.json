{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Plantilla 1 - EC2 con Elastic IP (KeyPair y Security Group como parámetros)",
  
  "Parameters": {
    "KeyName": {
      "Description": "Nombre del KeyPair existente",
      "Type": "AWS::EC2::KeyPair::KeyName"
    },
    "SecurityGroupId": {
      "Description": "ID del Security Group existente",
      "Type": "AWS::EC2::SecurityGroup::Id"
    }
  },

  "Resources": {
    "Instancia3": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": "ami-0fb653ca2d3203ac1",
        "InstanceType": "t2.micro",
        "KeyName": { "Ref": "KeyName" },
        "SecurityGroupIds": [
          { "Ref": "SecurityGroupId" }
        ]
      }
    },

    "ElasticIP3": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "InstanceId": { "Ref": "Instancia3" }
      }
    }
  }
}
