{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Plantilla 1 - Creación de una instancia EC2 con Elastic IP (Lab15)",
  "Resources": {
    "Instancia3": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
